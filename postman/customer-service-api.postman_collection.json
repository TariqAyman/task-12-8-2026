{
    "info": {
        "name": "Customer & Service API",
        "description": "CRUD REST API over customers and the services they subscribe to.\n\n**Authentication** \u2014 every request except `Log in` is protected. Two schemes are accepted on the same routes:\n\n- **Bearer token** (collection default): run `Authentication \u2192 Log in` once; its test script stores `access_token` in the `token` collection variable and every other request reuses it.\n- **HTTP Basic**: `{{email}}` / `{{password}}`, shown by `Authentication \u2192 List customers with HTTP Basic`.\n\n**Variables** \u2014 set `baseUrl`, `email` and `password` in the environment. `customerId` and `serviceId` are filled in automatically by the two create requests.\n\nGenerated from the OpenAPI document at `/api/documentation`.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{token}}",
                "type": "string"
            }
        ]
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:8000/api/v1",
            "type": "string"
        },
        {
            "key": "email",
            "value": "test@example.com",
            "type": "string"
        },
        {
            "key": "password",
            "value": "password",
            "type": "string"
        },
        {
            "key": "token",
            "value": "",
            "type": "string"
        },
        {
            "key": "customerId",
            "value": "1",
            "type": "string"
        },
        {
            "key": "serviceId",
            "value": "1",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "Authentication",
            "description": "Obtain and manage personal access tokens.",
            "item": [
                {
                    "name": "Log in",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/auth/login",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "login"
                            ]
                        },
                        "description": "Exchanges an email and password for a Sanctum personal access token. The test script stores the token in the `token` collection variable, so run this first.",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"{{email}}\",\n    \"password\": \"{{password}}\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "auth": {
                            "type": "noauth"
                        }
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "const body = pm.response.json();",
                                    "",
                                    "pm.test('a token is issued', function () {",
                                    "    pm.response.to.have.status(200);",
                                    "    pm.expect(body).to.have.property('access_token');",
                                    "});",
                                    "",
                                    "pm.collectionVariables.set('token', body.access_token);"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Authenticated user",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/auth/me",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "me"
                            ]
                        },
                        "description": "Returns the user the request was authenticated as."
                    },
                    "response": []
                },
                {
                    "name": "Refresh token",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/auth/refresh",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "refresh"
                            ]
                        },
                        "description": "Revokes the token the request was made with and issues a new one. The test script replaces the stored token. Requires a bearer token; Basic credentials cannot be refreshed."
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "const body = pm.response.json();",
                                    "",
                                    "pm.test('a token is issued', function () {",
                                    "    pm.response.to.have.status(200);",
                                    "    pm.expect(body).to.have.property('access_token');",
                                    "});",
                                    "",
                                    "pm.collectionVariables.set('token', body.access_token);"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Log out",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/auth/logout",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "logout"
                            ]
                        },
                        "description": "Revokes the token the request was made with."
                    },
                    "response": []
                },
                {
                    "name": "List customers with HTTP Basic",
                    "request": {
                        "method": "GET",
                        "auth": {
                            "type": "basic",
                            "basic": [
                                {
                                    "key": "username",
                                    "value": "{{email}}",
                                    "type": "string"
                                },
                                {
                                    "key": "password",
                                    "value": "{{password}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/customers",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "customers"
                            ]
                        },
                        "description": "The same endpoint as `Customers \u2192 List customers`, authenticated with HTTP Basic instead of a bearer token. No token is needed for this scheme."
                    },
                    "response": []
                }
            ]
        },
