                        "description": "Creates a customer. `name` and `email` are required and the email must be unique. The test script stores the new id in `customerId`.",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"name\": \"Jane Doe\",\n    \"email\": \"jane@example.com\",\n    \"phone\": \"+1 555 0100\",\n    \"company\": \"Doe Consulting\",\n    \"address\": \"1 Market Street\",\n    \"city\": \"Berlin\",\n    \"country\": \"Germany\",\n    \"status\": \"active\",\n    \"notes\": \"Key account.\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    },
                    "response": [],
